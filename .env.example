# Copy this file to `.env` (which is git-ignored) and fill in your values.
# The app loads `.env` automatically at startup (real env vars still win).

# ESI application Client ID (from https://developers.eveonline.com/applications).
# A PKCE client id is public, not a secret — but keep your .env out of git anyway.
EVE_COMMANDER_CLIENT_ID=

# Loopback redirect; must match the callback registered on your ESI app.
# Defaults to this value if unset.
EVE_COMMANDER_REDIRECT_URI=http://localhost:8787/callback
